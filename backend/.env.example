PROJECT_NAME=Knowledge QA Subsystem
API_VERSION=0.1.0
API_PREFIX=/api
ENVIRONMENT=development

# Vue dev server and local preview origins.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fill these after the MySQL and Neo4j groups provide real connection details.
MYSQL_DSN=mysql+pymysql://user:password@localhost:3306/heritage_qa
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
