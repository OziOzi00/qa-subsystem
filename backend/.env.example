PROJECT_NAME=Knowledge QA Subsystem
API_VERSION=0.1.0
API_PREFIX=/api
ENVIRONMENT=development

# Vue dev server and local preview origins.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Copy this file to backend/.env and fill the real credentials locally.
# Never commit backend/.env or any file containing real passwords.

# Public MySQL format:
# MYSQL_DSN=mysql+pymysql://<username>:<password>@mysql6.sqlpub.com:3311/seitem?charset=utf8mb4
MYSQL_DSN=mysql+pymysql://<username>:<password>@<host>:<port>/<database>?charset=utf8mb4

# Neo4j Python driver uses bolt/neo4j URI schemes.
# If the provided endpoint is host:7687, use bolt://<host>:7687.
NEO4J_URI=bolt://<host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<password>

# Optional lightweight RAG generation.
# Supports OpenAI-compatible chat completion APIs.
# Leave LLM_API_KEY empty to use deterministic template fallback.
LLM_ENABLED=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
